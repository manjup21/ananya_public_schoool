# Server
NODE_ENV=development
PORT=5025
API_PREFIX=/api

# CORS — production only (dev allows all origins). Comma-separated frontend URLs:
# CORS_ORIGINS=https://ananyapublicschool.edudisk.in

# PostgreSQL (use DATABASE_URL OR individual PG* vars)
DATABASE_URL=
PGHOST=localhost
PGPORT=5432
PGUSER=
PGPASSWORD=
PGDATABASE=ananya_public_school_erp
PGSSL=false
PGSSL_REJECT_UNAUTHORIZED=true
PGPOOL_MAX=20
PG_IDLE_TIMEOUT_MS=30000
PG_CONNECTION_TIMEOUT_MS=10000

# Auth
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=8h
AUTH_COOKIE_NAME=ananya_erp_token
BCRYPT_ROUNDS=10

# AES-256-GCM (generate: openssl rand -base64 32)
AES_KEY_BASE64=

# School branding
SCHOOL_NAME=Ananya Public School

# Student passport photos (absolute or relative path; default: backend/uploads)
# UPLOAD_DIR=

# Rate limiting
RATE_LIMIT_ENABLED=true
RATE_LIMIT_LOGIN_MAX=10
RATE_LIMIT_LOGIN_WINDOW_MS=900000
RATE_LIMIT_API_MAX=300
RATE_LIMIT_API_WINDOW_MS=900000

# MSG91 / WhatsApp (leave AUTH_KEY blank in git — set locally/prod)
# Exam ananya_chikbennur_result:
#   body_1=exam, body_2=student, body_3=date, body_4=subject marks,
#   body_5=total, body_6=max, body_7=percentage
# Attendance ananya_chikbennur_attendence:
#   body_1=student, body_2=date, body_3=absent slots, body_4=school name
# Fee (template name TBD): body_1=student, body_2=due date, body_3=pending amount
#   (office phone is fixed in WhatsApp templates)
MSG91_AUTH_KEY=
MSG91_INTEGRATED_NUMBER=916362651525
MSG91_WHATSAPP_NAMESPACE=712f9ea1_03ce_4635_af2e_a1828421678e
MSG91_WHATSAPP_ATTENDANCE_TEMPLATE=ananya_chikbennur_attendence
MSG91_WHATSAPP_EXAM_TEMPLATE=ananya_chikbennur_result
MSG91_WHATSAPP_FEE_DUE_TEMPLATE=
SCHOOL_PHONE=+919986708297
